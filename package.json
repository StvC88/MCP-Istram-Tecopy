{
  "name": "istram-mcp",
  "version": "0.2.0-rc.1",
  "description": "Local MCP for ISTRAM/ISPOL with evidence-based diagnostics and recoverable project changes",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "istram-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:python": "python -m unittest discover -s python -p test_*.py",
    "test:acceptance": "node scripts/acceptance.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "22.13.10",
    "typescript": "5.8.2"
  },
  "license": "MIT"
}
